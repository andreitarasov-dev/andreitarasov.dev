---
import Layout from '@sikorsky/site/components/Layout.astro';
import OverviewMap from '../../components/summerside/OverviewMap.astro';
import StoryRoute from '../../components/summerside/StoryRoute.astro';
import StoryPhoto from '../../components/summerside/StoryPhoto.astro';
import StoryBlocks from '../../components/summerside/StoryBlocks.astro';
import PhotoViewer from '../../components/summerside/PhotoViewer.astro';
import article from '../../content/summerside/article.en.json';
import media from '../../content/summerside/media.json';
import inventory from '../../content/summerside/inventory.json';
import type {StorySection,StoryPhoto as Photo} from '../../lib/summerside/types';
import '../../styles/summerside.css';
const sections=article as StorySection[],photos=media as Photo[];
const cities=sections.filter(s=>s.stage);
const byId=new Map(photos.map(p=>[p.id,p]));
const gallery=inventory.photoIds;
const before=sections.filter(s=>!s.stage&&s.id!=='end');
const end=sections.find(s=>s.id==='end')!;
---
<Layout title="Across Europe by bicycle" description="Our 2018 cycling journey across Europe: two stages, over 2,000 km, and 24 days in the saddle.">
 <article class="summerside" data-story>
  <header class="story-header" id="top">
   <div class="metadata"><time datetime="2018">Summer 2018</time><span> · cycling, maps</span></div>
   <h1 id="title">Across Europe by bicycle</h1>
   <h2>Two stages. 2,000 km. 24 days of riding.</h2>
  </header>
  <OverviewMap/>
  <div class="story-prose">{before.map(section=><section id={section.id}><h2>{section.title}</h2><StoryBlocks section={section}/>{section.id==='intro'&&<StoryPhoto photo={byId.get('intro')!}/>}</section>)}</div>
  <div class="story-journey">
   <StoryRoute/>
   <div class="story-chapters">{cities.map((section,i)=>{
     const start=gallery.indexOf(section.photoId!);const next=cities[i+1];const finish=next?gallery.indexOf(next.photoId!):gallery.length;
     return <section id={section.id} data-story-section data-anchor-stage={section.stage} data-anchor-progress={section.progress} data-anchor-label={section.title}>
      {section.id==='copenhagen'&&<p class="story-transfer">Stage 02 · After the bus journey from Amsterdam</p>}
      <h2>{section.title}</h2><StoryBlocks section={section}/>
      <div class="story-gallery">{gallery.slice(start,finish).map(id=><StoryPhoto photo={byId.get(id)!}/>)}</div>
     </section>;
   })}</div>
  </div>
  <section class="story-prose" id="end"><h2>{end.title}</h2><StoryBlocks section={end}/><a href="#top" class="link">Back to the beginning ↑</a></section>
  <PhotoViewer/>
 </article>
</Layout>
<script>
 import {initStoryRoute} from '../../scripts/summerside-route';
 import {initPhotoViewer} from '../../scripts/summerside-viewer';
 const root=document.querySelector<HTMLElement>('[data-story]');
 if(root) {initStoryRoute(root);initPhotoViewer(root);}
 // WebKit can interrupt a smooth scroll across this exceptionally long article.
 // Keep the shared breadcrumb's normal animation for short distances.
 document.querySelector('.breadcrumbs .current-page')?.addEventListener('click',(event)=>{
  if(scrollY<=innerHeight*10)return;
  event.preventDefault();event.stopImmediatePropagation();
  window.scrollTo({top:0,behavior:'instant'});
 },{capture:true});
</script>
