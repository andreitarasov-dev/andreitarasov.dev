---
import Layout from "@sikorsky/site/components/Layout.astro";

const AVATAR_SRC = "https://firebasestorage.googleapis.com/v0/b/andreitarasov-dev.firebasestorage.app/o/logo.png?alt=media&token=de4b54ba-88a1-48c6-9381-32d5c6cb5f27";

const DESCRIPTION = "Product engineer based in Leipzig. Web development, and notes on whatever else I'm building.";

interface Role {
  role: string;
  company: string;
  years: string;
}

/**
 * Year-range separator: thin space + en dash + thin space (&thinsp;–&thinsp;).
 * This is the convention the theme's own pages use for date ranges.
 */
const TO = " – ";

const experience: Role[] = [
  { role: "Senior Product Engineer", company: "CoachHub", years: `2025${TO}now` },
  { role: "Senior Frontend Engineer", company: "Monite", years: `2022${TO}2025` },
  { role: "Frontend Engineer", company: "Tinkoff", years: `2021${TO}2022` },
  { role: "Frontend Engineer", company: "Sibedge", years: `2019${TO}2021` },
  { role: "Frontend Engineer", company: "AIM", years: `2017${TO}2018` },
  { role: "Frontend Engineer", company: "Bryansk-Soft", years: "2017" },
  { role: "Web Developer", company: "Bit-Service / advertise.ru", years: `2013${TO}2017` }
];
---

<Layout title="Andrei Tarasov" description={DESCRIPTION}>
  <div class="index-page">
    <header>
      <img src={AVATAR_SRC} alt="Andrei Tarasov" class="avatar" id="avatar" />
      <h1 id="title">Andrei Tarasov</h1>
      <h2>Product engineer. Web development is where I go deepest — shaping a problem with product and design, then owning it through to the shipped interface.</h2>
      <h2>But not everything I build runs in a browser, and this is where the rest of it goes: projects, experiments, and notes on whatever I'm working through. Based in Leipzig.</h2>
      <h2>
        You can reach me on <a href="https://www.linkedin.com/in/andrei-tarasov/" class="link" target="_blank">LinkedIn</a>, <a href="https://github.com/andreitarasov-dev" class="link" target="_blank">GitHub</a>, or at <a href="mailto:tarasov.a.dev@gmail.com" class="link">tarasov.a.dev@gmail.com</a>.
      </h2>
    </header>

    <section id="professional-experience">
      <h3>Professional Experience</h3>
      <ul>
        {
          experience.map((job) => (
            <li>
              <div>
                <strong>
                  {job.role},{" "}
                  <span class="secondary">
                    {job.company}, {job.years}
                  </span>
                </strong>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>

<script>
  import { initHomeAvatar } from "../scripts/home-avatar";

  document.addEventListener("DOMContentLoaded", () => {
    initHomeAvatar();
  });
</script>
