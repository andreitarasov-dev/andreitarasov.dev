---
import type {StoryPhoto} from '../../lib/summerside/types';
interface Props {photo:StoryPhoto; eager?:boolean}
const {photo,eager=false}=Astro.props;
---
<figure class="story-photo" data-photo-id={photo.id}>
    <picture>
      {photo.sources.map(source=><source type={source.type} srcset={source.srcset} sizes="(max-width: 893px) 100vw, 840px" />)}
      <img src={photo.fullUrl} alt={photo.alt} width={photo.width} height={photo.height} loading={eager?'eager':'lazy'} decoding="async" />
    </picture>
  {photo.caption && <figcaption>{photo.caption}</figcaption>}
</figure>
