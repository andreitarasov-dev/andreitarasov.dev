<dialog class="photo-viewer" aria-label="Journey photographs" data-photo-viewer>
 <div class="viewer-toolbar"><span data-viewer-counter></span><button type="button" data-viewer-close aria-label="Close photographs" autofocus>Close ×</button></div>
 <div class="viewer-image"><img data-viewer-image alt=""/><p data-viewer-error hidden role="status">This photograph could not be loaded.</p></div>
 <div class="viewer-footer"><button type="button" data-viewer-previous aria-label="Previous photograph">← Previous</button><p data-viewer-caption></p><button type="button" data-viewer-next aria-label="Next photograph">Next →</button></div>
</dialog>
