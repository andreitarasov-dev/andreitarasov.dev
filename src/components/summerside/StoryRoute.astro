---
import {buildStageGeometry} from '../../lib/summerside/geometry';
import routes from '../../content/summerside/routes.json';
import type {RouteStage} from '../../lib/summerside/types';
const stages=routes as RouteStage[];
---
<aside class="story-route" data-story-route aria-label="Journey progress">
 <strong data-route-label>Kaliningrad → Amsterdam</strong>
 <span data-route-percent hidden aria-hidden="true"></span>
 {stages.map(stage=><div data-stage={stage.id}>
  {[false,true].map(compact=>{const geometry=buildStageGeometry(stage,compact);return <svg class={compact?'route-compact':'route-desktop'} viewBox={geometry.viewBox} role="img" aria-label={stage.id===1?'Stage 1: Kaliningrad to Amsterdam':'Stage 2: Copenhagen to Stockholm'}>
   <path class="route-base" d={geometry.path}/><path class="route-progress" data-route-path pathLength="1" d={geometry.path}/><circle data-route-marker r="5" class="route-marker" style="display:none"/>
  </svg>})}

 </div>)}

</aside>
